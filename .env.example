APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_KEY=

DATABASE_URL=postgresql+psycopg://tracerag:tracerag@postgres:5432/tracerag
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=20
INGESTION_MODE=celery

# Local, reproducible retrieval stack.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANK_BACKEND=fastembed
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# OpenAI-compatible chat endpoint. Use mock for zero-key local smoke tests.
LLM_BACKEND=mock
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-chat-model
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1

CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=180
DENSE_K=20
SPARSE_K=20
RERANK_CANDIDATES=12
DEFAULT_TOP_K=6
RRF_K=60
RETRIEVAL_CACHE_TTL_SECONDS=300
MAX_AGENT_STEPS=5
CHAT_HISTORY_MESSAGES=6

# Optional OTLP export. Leave blank to keep local tracing only.
OTEL_SERVICE_NAME=tracerag
OTEL_EXPORTER_OTLP_ENDPOINT=
